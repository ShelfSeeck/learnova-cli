# Required source paths
LEARNOVA_MIRROR_DATABASE=/path/to/Learnova/data/project.db
LEARNOVA_MIRROR_ARCHIVE_ROOT=/path/to/Learnova/archived_skill

# Persistent local clone of the generated skills-mirror repository
LEARNOVA_MIRROR_REPO=/path/to/learnova-mirror/repo

# Git settings inside LEARNOVA_MIRROR_REPO
LEARNOVA_MIRROR_REMOTE=origin
LEARNOVA_MIRROR_BRANCH=main
